# Rill backend environment.
#
# Copy to `.env` (or `.env.local`, which is loaded first) and fill in the blanks. The schema in
# `src/config/env.schema.ts` is the source of truth: it validates this file at boot and reports
# every problem at once. Variables left blank below have no default and will fail that check by
# name, which is deliberate — a missing escrow address should stop the process, not surface
# halfway through a workflow that has already spent someone's money.
#
# Commented-out variables are optional; the value shown is the schema default. In production no
# env file is read at all, so these must come from the process environment.

# ── app ─────────────────────────────────────────────────────────────────────────────────────────
# NODE_ENV=development                  # development | test | production
# PORT=4000                             # 3000 belongs to the Next.js app
# LOG_LEVEL=log                         # error | warn | log | debug | verbose
# Browser origins allowed to call the API, comma-separated.
# WEB_ORIGINS=http://localhost:3000

# ── privy (authentication) ──────────────────────────────────────────────────────────────────────
# Dashboard → App settings. The verification key is the app's ES256 *public* key, so access tokens
# are verified in-process; the app secret is not needed here. Paste the PEM with literal \n
# escapes on one line, or quote a real multi-line value.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# ── database ────────────────────────────────────────────────────────────────────────────────────
# Needs the pgvector extension: migration 0000 enables it, and the app refuses to boot without it.
DATABASE_URL=postgres://rill:rill@localhost:5432/rill
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false                    # true | false

# ── redis ───────────────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── temporal ────────────────────────────────────────────────────────────────────────────────────
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=rill

# ── chain ───────────────────────────────────────────────────────────────────────────────────────
BSC_RPC_URL=https://bsc-dataseed.binance.org
# BSC_CHAIN_ID=56                       # 56 mainnet, 97 testnet

# ── altana ──────────────────────────────────────────────────────────────────────────────────────
# ALTANA_CHAIN=bnb                      # bnb | ethereum | base
# Where session private keys are read from. Never the database, and never this file in production.
# SESSION_SECRET_PROVIDER=env           # env | file | vault | aws_secrets_manager | gcp_secret_manager

# ── x402 ────────────────────────────────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=
# The address agents pay when Rill is itself the x402 merchant.
X402_MERCHANT_ADDRESS=

# ── erc-8183 / erc-8004 ─────────────────────────────────────────────────────────────────────────
ERC8183_ESCROW_ADDRESS=
ERC8004_REGISTRY_ADDRESS=

# ── ai ──────────────────────────────────────────────────────────────────────────────────────────
# Swap vendors without touching parser code. Gemini uses @google/genai; OpenAI and Anthropic
# use their own SDKs. Embedding provider is separate — Anthropic has no embedding model.
# AI_PROVIDER=gemini                    # gemini | openai | anthropic
# AI_EMBEDDING_PROVIDER=gemini          # gemini | openai
# PLANNER_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001  # 1536 dimensions, matching the vector columns
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
