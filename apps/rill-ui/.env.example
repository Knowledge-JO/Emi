# Rill web app environment.
#
# Copy to `.env.local` and fill in the blanks. Everything here is `NEXT_PUBLIC_`, meaning it is
# inlined into the browser bundle at build time — so nothing secret belongs in this file. The
# Privy app ID is public by design; the app secret is not needed by either the web app or the API.

# Dashboard → App settings. Without it the app throws on first render rather than showing a login
# button that cannot work.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: only needed if you use per-environment app clients in the Privy dashboard.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Where the Rill API lives. Must appear in the API's own WEB_ORIGINS for CORS to pass.
# NEXT_PUBLIC_API_URL=http://localhost:4000
