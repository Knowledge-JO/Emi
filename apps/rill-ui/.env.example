# Emi web app environment.
#
# Copy to `.env.local` and fill in the blanks. Everything here is `NEXT_PUBLIC_`, meaning it is
# inlined into the browser bundle at build time — so nothing secret belongs in this file. The
# Privy app ID is public by design; the app secret is not needed by either the web app or the API.

# Dashboard → App settings. Enable Email, Google, and Apple on the Login methods page —
# https://dashboard.privy.io/apps?page=login-methods — or those buttons will fail.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: only needed if you use per-environment app clients in the Privy dashboard.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Where the Emi API lives. Must appear in the API's own WEB_ORIGINS for CORS to pass.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Altana chain the passkey wallet is provisioned on. Must match the API's ALTANA_CHAIN.
# NEXT_PUBLIC_ALTANA_CHAIN=bnb          # bnb | bnb-testnet | ethereum
